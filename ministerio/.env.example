# Supabase (obtenidos desde Project Settings > API en supabase.com, o `supabase status` en local)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Solo para scripts de servidor (seed, Edge Functions). NUNCA exponer en el cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Claves VAPID para Web Push (generar con: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@tu-iglesia.org
